# Environment
NODE_ENV=development
PORT=3000

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/solvora

# Product Configuration
PRODUCT_NAME=5-Panel Foldable Solar Charger
PRODUCT_PRICE_ORIGINAL=4500
PRODUCT_PRICE_OFFER=2350
PRODUCT_DELIVERY_CHARGE=100

# Payment Methods - bKash Personal Account
BKASH_PERSONAL_NUMBER=01700000000
BKASH_ACCOUNT_NAME=SOLVORA Business

# Payment Methods - Nagad Personal Account
NAGAD_PERSONAL_NUMBER=01600000000
NAGAD_ACCOUNT_NAME=SOLVORA Business

# WhatsApp
WHATSAPP_NUMBER=8801700000000

# Admin
ADMIN_EMAIL=admin@solvora.com
ADMIN_PASSWORD_HASH=

# Future Payment Gateway Credentials (leave empty for now)
BKASH_MERCHANT_KEY=
BKASH_MERCHANT_SECRET=
BKASH_API_URL=

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_API_URL=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@solvora.com

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_ORDERS=10
RATE_LIMIT_WINDOW=15m
